{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/London",
  "reviewers": [
    "alunduil"
  ],
  // Closing a Renovate pull request tells Renovate that version is
  // unwanted and it stops re-offering it, so a stale sweep has to exempt
  // them by label.
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  // hackage reports no release timestamps, so the default
  // timestamp-required mode holds every cabal update forever rather than
  // for three days. Datasources that do report them keep the full bake.
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      // None of these update types can carry a release timestamp, so a bake
      // period strands them on a pending status check with no pull request.
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track every GHC series reference so a new series arrives as a single pull request.",
      // An unmatched file pattern yields no error, only zero updates.
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/\\.cabal$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ghc-version: \"(?<currentValue>\\d+\\.\\d+)\"",
        "GHC == (?<currentValue>\\d+\\.\\d+)\\.\\*",
        "name: [^\\n]*GHC (?<currentValue>\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "endoflife-date",
      "depNameTemplate": "ghc",
      "versioningTemplate": "loose",
      // endoflife-date resolves a cycle to its latest patch, which would
      // narrow tested-with and the CI pin from a series to one release.
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "pre-commit": {
    "enabled": true
  }
}
