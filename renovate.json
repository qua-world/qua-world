{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/London",
  "reviewers": [
    "alunduil"
  ],
  // Closing a Renovate pull request tells Renovate that version is
  // unwanted and it stops re-offering it, so a stale sweep has to exempt
  // them by label.
  "labels": [
    "dependencies"
  ],
  // The branch ruleset's required checks gate the merge. Renovate's own wait
  // covers every check, so a stuck optional one such as Codecov would stall it.
  "ignoreTests": true,
  "minimumReleaseAge": "3 days",
  // hackage reports no release timestamps, so the default
  // timestamp-required mode holds every cabal update forever rather than
  // for three days. Datasources that do report them keep the full bake.
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  // No packaged manager reads the GHC series pins. endoflife.date lists GHC by
  // release series but labels each series with its newest point release, so
  // extractVersionTemplate trims the label back to the series.
  //
  // Both managers extract the same dependency, so one branch carries both edits.
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned GHC series in the CI workflow",
      "managerFilePatterns": [
        ".github/workflows/ci.yml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+ghc-version\\s*:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s"
      ],
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "customType": "regex",
      "description": "Update the pinned GHC series in the cabal tested-with",
      "managerFilePatterns": [
        "*.cabal"
      ],
      "matchStrings": [
        "-- renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+tested-with\\s*:\\s*GHC == (?<currentValue>.+?)\\.\\*"
      ],
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    }
  ],
  "packageRules": [
    {
      // None of these update types can carry a release timestamp, so a bake
      // period strands them on a pending status check with no pull request.
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "minimumReleaseAge": null
    },
    {
      // A hold overrides this rule only when listed after it.
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "A breaking change, such as a semver 0.x minor, can pass every check and still break behaviour no test covers",
      "matchIsBreaking": true,
      "automerge": false
    },
    {
      "description": "The admin applies the bootstrap layer by hand with admin credentials, and no CI job plans it",
      "matchFileNames": [
        "terraform/bootstrap/**"
      ],
      "automerge": false
    },
    {
      "description": "A merge to develop applies the infrastructure layer, and a green plan doesn't show the change is safe",
      "matchFileNames": [
        "terraform/infrastructure/**",
        ".github/workflows/infrastructure.yml"
      ],
      "automerge": false
    },
    {
      "description": "A release job runs its actions beside its publishing credential. Runner images are exempt: GitHub supplies them and issues the job's OIDC token, so the job already trusts GitHub.",
      "matchFileNames": [
        ".github/workflows/release.yml",
        ".github/actions/**"
      ],
      "matchDatasources": [
        "!github-runners"
      ],
      "automerge": false
    }
  ],
  "osvVulnerabilityAlerts": true,
  "pre-commit": {
    "enabled": true
  }
}
