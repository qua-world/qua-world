root = true

# The pre-commit hooks enforce these same rules at commit. Change both sides
# together, or the hooks overwrite what the editor produced.
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2

[*.bats]
indent_size = 4
