cabal-version:       3.0
-- 3.0 is the floor for the `partir-qua-world:glut-client` dependency syntax.

-- SPDX-FileCopyrightText: 2020 Alex Brandt
--
-- SPDX-License-Identifier: MIT

name:                partir-qua-world
version:             0.1.0.0

license:             MIT
license-file:        LICENSE

copyright:           (c) 2020 Alex Brandt

author:              Alex Brandt
maintainer:          alunduil@gmail.com

stability:           alpha

homepage:            https://github.com/qua-world/qua-world
bug-reports:         https://github.com/qua-world/qua-world/issues

synopsis:            GUI Client and Client Interfaces for qua.world
description:
  A GUI client for interacting with the qua.world MMO gaming environment and
  client interfaces for creating bots, automation, and other actors in the game
  world.

category:            Game

-- renovate: datasource=endoflife-date depName=ghc versioning=loose
tested-with:         GHC == 9.10.*

extra-doc-files:
    CHANGELOG.md

extra-source-files:
    LICENSE

-- Reached through `Paths_partir_qua_world`, so the client finds it wherever
-- it runs from and not only in a source checkout.
data-files:
    examples/avatar.glb
    examples/level.ldtk
    examples/level.tmj
    examples/pyramid.obj
    examples/sprites.png
    examples/walk/*.png

source-repository head
  type:              git
  location:          https://github.com/qua-world/qua-world.git
  branch:            develop

common warnings
  ghc-options:         -Wall

common language
  default-language:    Haskell2010

common deps
  build-depends:
      base >= 4.20 && < 4.23

library
  import:              warnings, language, deps

  exposed-modules:
      Partir.Agent.Class
    , Partir.Agent.Input
    , Partir.Agent.Null
    , Partir.Asset
    , Partir.Asset.Animation
    , Partir.Asset.Animation.PNG
    , Partir.Asset.GLTF
    , Partir.Asset.OBJ
    , Partir.Asset.Sprite
    , Partir.Asset.Sprite.PNG
    , Partir.Asset.Tilemap
    , Partir.Asset.Tilemap.LDtk
    , Partir.Asset.Tilemap.Tiled
    , Partir.Sim.Interpolate
    , Partir.Sim.Loop
    , Partir.World.Event
    , Partir.World.Scene
    , Partir.World.Types

  other-modules:

  build-depends:
      aeson >= 2.2 && < 2.3
    , aeson-tiled >= 0.0.2 && < 0.1
    , bytestring >= 0.12 && < 0.13
    , containers >= 0.7 && < 0.9
    , directory >= 1.3.8 && < 1.4
    , file-io >= 0.2 && < 0.3
    , filepath >= 1.5 && < 1.6
    , gltf-loader >= 0.3 && < 0.4
    , JuicyPixels >= 3.3 && < 3.4
    , ldtk-types >= 1.2 && < 1.3
    , linear >= 1.23 && < 1.24
    , text >= 2.1 && < 2.2
    , vector >= 0.13 && < 0.14
    , wavefront >= 0.7.2 && < 0.8

  hs-source-dirs:
      src

-- A target's `main-is` module cannot be imported, and an executable's
-- `other-modules` are private to it. The client's modules live in a library so
-- the test suite can reach them.
library glut-client
  import:              warnings, language, deps

  exposed-modules:
      Partir.Client.GLUT.Commands
    , Partir.Client.GLUT.Controls
    , Partir.Client.GLUT.Render
    , Partir.Client.GLUT.View

  build-depends:
      bytestring >= 0.12 && < 0.13
    , GLUT >= 2.7 && < 2.8
    , linear >= 1.23 && < 1.24
    , OpenGL >= 3.0 && < 3.1
    , optparse-applicative >= 0.18 && < 0.20
    , partir-qua-world
    , StateVar >= 1.2 && < 1.3
    , vector >= 0.13 && < 0.14

  hs-source-dirs:
      app

test-suite partir-qua-world-test
  import:              warnings, language, deps

  type:                exitcode-stdio-1.0

  hs-source-dirs:
      test

  main-is:             Spec.hs

  other-modules:
      Partir.Agent.NullSpec
    , Partir.Arbitrary
    , Partir.Asset.Animation.PNGSpec
    , Partir.Asset.AnimationSpec
    , Partir.Asset.Bundled
    , Partir.Asset.GLTFSpec
    , Partir.Asset.OBJSpec
    , Partir.Asset.Sprite.PNGSpec
    , Partir.Asset.Sprite.Pixels
    , Partir.Asset.Sprite.Sample
    , Partir.Asset.SpriteSpec
    , Partir.Asset.Tilemap.LDtkSpec
    , Partir.Asset.Tilemap.Sample
    , Partir.Asset.Tilemap.SampleSpec
    , Partir.Asset.Tilemap.TiledSpec
    , Partir.Asset.TilemapSpec
    , Partir.Client.GLUT.ControlsSpec
    , Partir.Client.GLUT.ViewSpec
    , Partir.Sim.InterpolateSpec
    , Partir.Sim.LoopSpec
    , Partir.World.SceneSpec
    , Paths_partir_qua_world

  autogen-modules:
      Paths_partir_qua_world

  build-depends:
      bytestring >= 0.12 && < 0.13
    , containers >= 0.7 && < 0.9
    , filepath >= 1.5 && < 1.6
    , GLUT >= 2.7 && < 2.8
    , JuicyPixels >= 3.3 && < 3.4
    , linear >= 1.23 && < 1.24
    , OpenGL >= 3.0 && < 3.1
    , partir-qua-world
    , partir-qua-world:glut-client
    , QuickCheck >= 2.14 && < 2.19
    , tasty >= 1.5 && < 1.6
    , tasty-hunit >= 0.10 && < 0.11
    , tasty-quickcheck >= 0.10 && < 0.12
    , temporary >= 1.3 && < 1.4
    , text >= 2.1 && < 2.2
    , vector >= 0.13 && < 0.14

  build-tool-depends:
      tasty-discover:tasty-discover >= 5.2 && < 5.3

executable partir-glut
  import:              warnings, language, deps

  main-is:             Partir/Client/GLUT/Main.hs

  other-modules:
      Paths_partir_qua_world

  autogen-modules:
      Paths_partir_qua_world

  build-depends:
      filepath >= 1.5 && < 1.6
    , GLUT >= 2.7 && < 2.8
    , optparse-applicative >= 0.18 && < 0.20
    , partir-qua-world
    , partir-qua-world:glut-client
    , StateVar >= 1.2 && < 1.3

  -- Cabal treats every module under a target's hs-source-dirs as a home
  -- module, so two targets sharing a directory each recompile the other's
  -- modules and fail on dependencies they do not declare. Main.hs therefore
  -- gets a directory to itself.
  hs-source-dirs:
      exe
