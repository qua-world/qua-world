cabal-version:       3.0
-- ^ 3.0 is the floor for the `partir-qua-world:glut-client` dependency
-- syntax, and it has to be the file's first line.

name:                partir-qua-world
version:             0.1.0.0

license:             MIT
license-file:        LICENSE

copyright:           (c) 2020 Alex Brandt

author:              Alex Brandt
maintainer:          alunduil@gmail.com

stability:           alpha

homepage:            https://github.com/qua-world/partir.qua.world
bug-reports:         https://github.com/qua-world/partir.qua.world/issues

synopsis:            GUI Client and Client Interfaces for qua.world
description:
  A GUI client for interacting with the qua.world MMO gaming environment and
  client interfaces for creating bots, automation, and other actors in the game
  world.

category:            Game

-- renovate: datasource=endoflife-date depName=ghc versioning=loose
tested-with:         GHC == 9.10.*

extra-doc-files:
    CHANGELOG.md

extra-source-files:
    LICENSE

source-repository head
  type:              git
  location:          https://github.com/qua-world/partir.qua.world.git
  branch:            develop

common warnings
  ghc-options:         -Wall

common language
  default-language:    Haskell2010

common deps
  build-depends:
      base >= 4.20 && < 4.23

library
  import:              warnings, language, deps

  exposed-modules:
      Partir.Agent.Class
    , Partir.Agent.Input
    , Partir.Agent.Null
    , Partir.Sim.Interpolate
    , Partir.World.Event
    , Partir.World.Scene
    , Partir.World.Types

  other-modules:

  build-depends:
      containers >= 0.7 && < 0.9
    , linear >= 1.23 && < 1.24
    , text >= 2.1 && < 2.2

  hs-source-dirs:
      src

-- The client's modules live here rather than in the executable so the test
-- suite can import them; a target's `main-is` module is not importable.
library glut-client
  import:              warnings, language, deps

  exposed-modules:
      Partir.Client.GLUT.Commands
    , Partir.Client.GLUT.Controls

  build-depends:
      GLUT >= 2.7 && < 2.8
    , linear >= 1.23 && < 1.24
    , optparse-applicative >= 0.18 && < 0.20
    , partir-qua-world
    , StateVar >= 1.2 && < 1.3

  -- Cabal treats every module under a target's hs-source-dirs as a home
  -- module, so a target sharing a directory recompiles the modules there and
  -- fails on dependencies only their own target declares. Hence `exe`, not
  -- `app`, below.
  hs-source-dirs:
      app

test-suite partir-qua-world-test
  import:              warnings, language, deps

  type:                exitcode-stdio-1.0

  hs-source-dirs:
      test

  main-is:             Spec.hs

  other-modules:
      Partir.Agent.NullSpec
    , Partir.Client.GLUT.ControlsSpec
    , Partir.Sim.InterpolateSpec
    , Partir.World.SceneSpec

  build-depends:
      GLUT >= 2.7 && < 2.8
    , hspec >= 2.11 && < 2.12
    , linear >= 1.23 && < 1.24
    , partir-qua-world
    , partir-qua-world:glut-client
    , QuickCheck >= 2.14 && < 2.19
    , text >= 2.1 && < 2.2

  build-tool-depends:
      hspec-discover:hspec-discover >= 2.11 && < 2.12

executable partir-glut
  import:              warnings, language, deps

  main-is:             Partir/Client/GLUT/Main.hs

  build-depends:
      GLUT >= 2.7 && < 2.8
    , OpenGL >= 3.0 && < 3.1
    , optparse-applicative >= 0.18 && < 0.20
    , partir-qua-world:glut-client
    , StateVar >= 1.2 && < 1.3

  hs-source-dirs:
      exe
