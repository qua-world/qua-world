cabal-version:       2.4

name:                partir-qua-world
version:             0.2.1.0

license:             MIT
license-file:        LICENSE

copyright:           (c) 2020 Alex Brandt

author:              Alex Brandt
maintainer:          alunduil@gmail.com

stability:           alpha

homepage:            https://github.com/qua-world/partir.qua.world
bug-reports:         https://github.com/qua-world/partir.qua.world/issues

synopsis:            GUI Client and Client Interfaces for qua.world
description:
  A GUI client for interacting with the qua.world MMO gaming environment and
  client interfaces for creating bots, automation, and other actors in the game
  world.

category:            Game

tested-with:         GHC == 9.10.*

extra-source-files:
    CHANGELOG.md
  , LICENSE

source-repository head
  type:              git
  location:          https://github.com/qua-world/partir.qua.world.git
  branch:            develop

library
  exposed-modules:
      Partir
    , Partir.Sim.Interpolate
    , Partir.World.Event
    , Partir.World.Scene
    , Partir.World.Types

  other-modules:

  build-depends:
      base >= 4.20 && < 4.21
    , containers >= 0.7 && < 0.8
    , linear >= 1.22 && < 1.24
    , text >= 2.1 && < 2.2

  hs-source-dirs:
      src

  default-language:    Haskell2010

  ghc-options:         -Wall

test-suite partir-qua-world-test
  default-language:    Haskell2010
  type:                exitcode-stdio-1.0

  ghc-options:         -Wall

  hs-source-dirs:
      test

  main-is:             Spec.hs

  other-modules:
      Partir.Sim.InterpolateSpec
    , Partir.World.SceneSpec

  build-depends:
      base >= 4.20 && < 4.21
    , hspec >= 2.11 && < 2.12
    , linear >= 1.22 && < 1.24
    , partir-qua-world
    , QuickCheck >= 2.14 && < 2.16
    , text >= 2.1 && < 2.2

  build-tool-depends:
      hspec-discover:hspec-discover >= 2.11 && < 2.12

executable partir-glut
  main-is:             Partir/Client/GLUT/Main.hs

  other-modules:
      Partir
    , Partir.Client.GLUT.Commands
    , Partir.Client.GLUT.Controls

  build-depends:
      base >= 4.20 && < 4.21
    , GLUT >= 2.7 && < 2.8
    , OpenGL >= 3.0 && < 3.1
    , optparse-applicative >= 0.18 && < 0.19
    , partir-qua-world
    , StateVar >= 1.2 && < 1.3

  hs-source-dirs:
      src

  default-language:    Haskell2010

  ghc-options:         -Wall
