cabal-version:       2.4

name:                partir-qua-world
version:             0.1.0.0

license:             MIT
license-file:        LICENSE

copyright:           (c) 2020 Alex Brandt

author:              Alex Brandt
maintainer:          alunduil@gmail.com

stability:           alpha

homepage:            https://github.com/qua-world/partir.qua.world
bug-reports:         https://github.com/qua-world/partir.qua.world/issues

synopsis:            GUI Client and Client Interfaces for qua.world
description:
  A GUI client for interacting with the qua.world MMO gaming environment and
  client interfaces for creating bots, automation, and other actors in the game
  world.

category:            Game

tested-with:         GHC == 8.6.*

extra-source-files:
    CHANGELOG.md
  , LICENSE

source-repository head
  type:              git
  location:          https://github.com/qua-world/partir.qua.world.git
  branch:            develop

library
  exposed-modules:

  other-modules:

  build-depends:
      base >= 4.12 && < 4.13

  ghc-options:
      -Wall

  hs-source-dirs:
      src

  default-language:    Haskell2010

test-suite partir-qua-world-test
  default-language:    Haskell2010
  type:                exitcode-stdio-1.0

  hs-source-dirs:
      src
    , test

  main-is:             Spec.hs

  other-modules:
      Partir.Client.LambdaHack.Content
    , Partir.Client.LambdaHack.Content.CaveKind
    , Partir.Client.LambdaHack.Content.Internal
    , Partir.Client.LambdaHack.Content.InternalSpec
    , Partir.Client.LambdaHack.Content.ItemKind
    , Partir.Client.LambdaHack.Content.ItemKind.Actor
    , Partir.Client.LambdaHack.Content.ItemKind.Animal
    , Partir.Client.LambdaHack.Content.ItemKind.Condition
    , Partir.Client.LambdaHack.Content.ItemKind.Currency
    , Partir.Client.LambdaHack.Content.ItemKind.Embed
    , Partir.Client.LambdaHack.Content.ItemKind.Monster
    , Partir.Client.LambdaHack.Content.ItemKind.Organ
    , Partir.Client.LambdaHack.Content.ItemKind.Potion
    , Partir.Client.LambdaHack.Content.ItemKind.Weapon
    , Partir.Client.LambdaHack.Content.ModeKind
    , Partir.Client.LambdaHack.Content.PlaceKind
    , Partir.Client.LambdaHack.Content.RuleKind
    , Partir.Client.LambdaHack.Content.TileKind

  build-depends:
      base >=4.12 && < 4.13
    , hspec >= 2.7 && < 2.8
    , LambdaHack >= 0.9 && < 0.10
    , partir-qua-world
    , text >= 1.2 && < 1.3

  ghc-options:
      -Wall

  build-tool-depends:
      hspec-discover:hspec-discover >= 2.7 && < 2.8

executable partir-glut
  main-is:             Partir/Client/GLUT/Main.hs

  other-modules:
      Partir.Client.GLUT.Commands
    , Partir.Client.GLUT.Controls

  build-depends:
      base >= 4.12 && < 4.13
    , GLUT >= 2.7 && < 2.8
    , OpenGL >= 3.0 && < 3.1
    , optparse-applicative >= 0.14 && < 0.15
    , partir-qua-world
    , StateVar >= 1.2 && < 1.3

  ghc-options:
      -Wall

  hs-source-dirs:
      src

  default-language:    Haskell2010

executable partir-lambdahack
  main-is:             Partir/Client/LambdaHack/Main.hs

  other-modules:
      Partir.Client.LambdaHack.Content
    , Partir.Client.LambdaHack.Content.CaveKind
    , Partir.Client.LambdaHack.Content.Internal
    , Partir.Client.LambdaHack.Content.ItemKind
    , Partir.Client.LambdaHack.Content.ItemKind.Actor
    , Partir.Client.LambdaHack.Content.ItemKind.Animal
    , Partir.Client.LambdaHack.Content.ItemKind.Condition
    , Partir.Client.LambdaHack.Content.ItemKind.Currency
    , Partir.Client.LambdaHack.Content.ItemKind.Embed
    , Partir.Client.LambdaHack.Content.ItemKind.Monster
    , Partir.Client.LambdaHack.Content.ItemKind.Organ
    , Partir.Client.LambdaHack.Content.ItemKind.Potion
    , Partir.Client.LambdaHack.Content.ItemKind.Weapon
    , Partir.Client.LambdaHack.Content.ModeKind
    , Partir.Client.LambdaHack.Content.PlaceKind
    , Partir.Client.LambdaHack.Content.RuleKind
    , Partir.Client.LambdaHack.Content.TileKind

  build-depends:
      base >= 4.12 && < 4.13
    , LambdaHack >= 0.9 && < 0.10
    , optparse-applicative >= 0.14 && < 0.15
    , partir-qua-world
    , text >= 1.2 && < 1.3

  ghc-options:
      -Wall

  hs-source-dirs:
      src

  default-language:    Haskell2010
