cabal-version:       2.4

name:                partir-qua-world
version:             0.1.0.0

license:             MIT
license-file:        LICENSE

copyright:           (c) 2020 Alex Brandt

author:              Alex Brandt
maintainer:          alunduil@gmail.com

stability:           alpha

homepage:            https://github.com/qua-world/partir.qua.world
bug-reports:         https://github.com/qua-world/partir.qua.world/issues

synopsis:            GUI Client and Client Interfaces for qua.world
description:
  A GUI client for interacting with the qua.world MMO gaming environment and
  client interfaces for creating bots, automation, and other actors in the game
  world.

category:            Game

tested-with:         GHC == 8.6.*

extra-source-files:
    CHANGELOG.md
  , LICENSE

source-repository head
  type:              git
  location:          https://github.com/qua-world/partir.qua.world.git
  branch:            develop

library
  exposed-modules:
      Partir

  other-modules:

  build-depends:
      base >= 4.12 && < 4.13

  hs-source-dirs:
      src

  default-language:    Haskell2010

test-suite partir-qua-world-test
  default-language:    Haskell2010
  type:                exitcode-stdio-1.0

  hs-source-dirs:
      src
    , test

  main-is:             Spec.hs

  build-depends:
      base >=4.12 && < 4.13
    , hspec >= 2.7 && < 2.8
    , partir-qua-world

  build-tool-depends:
      hspec-discover:hspec-discover >= 2.7 && < 2.8

executable partir
  main-is:             Partir/GUI/Main.hs

  other-modules:
      Partir

  build-depends:
      base >= 4.12 && < 4.13
    , partir-qua-world

  hs-source-dirs:
      src

  default-language:    Haskell2010
